# API Keys для получения курсов валют и цен акций
# Получите ключи на соответствующих сервисах

# Для курсов валют (например, exchangerate-api.com, apilayer.com и др.)
CURRENCY_API_KEY=your_currency_api_key_here

# Для цен акций (например, alphavantage.co, twelvedata.com и др.)
STOCKS_API_KEY=your_stocks_api_key_here
